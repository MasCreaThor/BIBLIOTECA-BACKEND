# Entorno de la aplicación
NODE_ENV=development

# Configuración del servidor
PORT=3000
API_PREFIX=api

# Configuración de la base de datos MongoDB
MONGODB_URI=mongodb://localhost:27017/biblioteca-escolar

# Configuración de JWT
JWT_SECRET=tu_super_secret_key_aqui_cambiala_en_produccion
JWT_EXPIRES_IN=24h

# Configuración de seguridad
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Configuración de logging
LOG_LEVEL=debug
LOG_DIRECTORY=logs

# Google Books API
GOOGLE_BOOKS_API_KEY=tu_api_key_de_google_books
GOOGLE_BOOKS_MAX_RESULTS=10

# Configuración de CORS
CORS_ORIGIN=http://localhost:3001

# Configuración de paginación
DEFAULT_PAGINATION_LIMIT=20
MAX_PAGINATION_LIMIT=100

# Configuración de archivos
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads

# Configuración de email (para recuperación de contraseña)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password_de_gmail
EMAIL_FROM=tu_email@gmail.com

# Frontend URL (para enlaces de recuperación)
FRONTEND_URL=http://localhost:3001

# Usuario administrador inicial (opcional)
ADMIN_EMAIL=admin@biblioteca.edu.co
ADMIN_PASSWORD=Admin123!